{
  "name": "mofer",
  "version": "1.0.0",
  "private": true,
  "description": "Museum of Far East Remembrance website, restored for Cloudflare Workers Static Assets.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "recover": "node scripts/recover.mjs",
    "build": "node scripts/build.mjs",
    "predev": "npm run build",
    "dev": "http-server dist -a 127.0.0.1 -p 4173 -c-1",
    "preview:cloudflare": "wrangler dev --local --ip 127.0.0.1 --port 4174",
    "check:deploy": "wrangler deploy --dry-run",
    "test": "playwright test"
  },
  "devDependencies": {
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-sans-tc": "5.3.0",
    "@fontsource-variable/noto-serif-jp": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@fontsource-variable/noto-serif-tc": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@playwright/test": "1.63.0",
    "http-server": "14.1.1",
    "lucide-static": "1.47.0",
    "parse5": "8.0.1",
    "wrangler": "4.133.0"
  }
}
